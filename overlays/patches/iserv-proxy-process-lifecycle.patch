+-- | Own the interpreter and race protocol progress against child exit. EOF is
+-- insufficient: descendants can keep stdout open after the interpreter dies.
+runPipedProxy :: Bool -> Bool -> Pipe -> [String] -> IO ()
+runPipedProxy verbose noLoadCall local args = E.mask $ \restore -> do
+  outcome <- newEmptyMVar :: IO (MVar (Either E.SomeException ()))
+  withCancellationHandlers outcome $ run restore outcome
+  where
+    run restore outcome = do
+      (remote, (hIn, hOut, ph)) <- spawnInterpreter verbose args
+      pid <- getPid ph
+      shuttingDown <- newIORef False
+      childExit <- newIORef Nothing
+      protocolThread <- forkIOWithUnmask $ \unmask -> do
+        result <- E.try $ unmask $
+          proxy verbose noLoadCall (atomicWriteIORef shuttingDown True) local remote
+        void $ tryPutMVar outcome result
+      childThread <- forkIOWithUnmask $ \unmask -> do
+        result <- E.try $ unmask $ waitInterpreter ph
+        case result of
+          Left err -> void $ tryPutMVar outcome (Left err)
+          Right exitCode -> do
+            writeIORef childExit (Just exitCode)
+            expected <- readIORef shuttingDown
+            unless (exitCode == ExitSuccess && expected) $
+              void $ tryPutMVar outcome (Left (E.toException (interpreterExit exitCode)))
+      let cleanup = do
+            -- Stop both workers before closing handles or returning to our caller.
+            -- Neither worker can publish an exception into a later compiler action.
+            killThread protocolThread
+            killThread childThread
+            mapM_ closePipe [hIn, hOut]
+            expected <- readIORef shuttingDown
+            when expected $ do
+              graceful <- timeout 5000000 (waitInterpreter ph)
+              forM_ graceful $ \code -> writeIORef childExit (Just code)
+            exited <- getProcessExitCode ph
+            forM_ exited $ \code -> writeIORef childExit (Just code)
+            when verbose $ trace "Terminating interpreter..."
+#if !defined(mingw32_HOST_OS)
+            let signalGroup sig = forM_ pid $ \group ->
+                  signalProcessGroup sig group `E.catch` \err -> do
+#if defined(darwin_HOST_OS)
+                    -- Darwin reports EPERM for groups containing only zombies.
+                    -- Recheck child exit before accepting that cleanup race.
+                    status <- if isPermissionError err
+                      then timeout 1000000 (waitInterpreter ph)
+                      else getProcessExitCode ph
+                    forM_ status $ \code -> writeIORef childExit (Just code)
+                    let gone = isDoesNotExistError err
+                          || (isPermissionError err && status /= Nothing)
+#else
+                    let gone = isDoesNotExistError err
+#endif
+                    unless gone (E.throwIO (err :: E.IOException))
+            signalGroup sigTERM
+#else
+            terminateProcess ph
+#endif
+            stopped <- timeout 5000000 (waitInterpreter ph)
+            forM_ stopped $ \code -> writeIORef childExit (Just code)
+#if !defined(mingw32_HOST_OS)
+            -- Also remove descendants when the immediate child already exited.
+            signalGroup sigKILL
+#else
+            when (stopped == Nothing) $ terminateProcess ph
+#endif
+            when (stopped == Nothing) $ do
+              reaped <- timeout 1000000 (waitInterpreter ph)
+              forM_ reaped $ \code -> writeIORef childExit (Just code)
+              when (reaped == Nothing) $
+                E.throwIO (userError "iserv-proxy: interpreter did not exit after termination")
+      result <- E.try $ restore $ takeMVar outcome
+      cleanupResult <- E.try cleanup :: IO (Either E.SomeException ())
+      exited <- readIORef childExit
+      primary <- case exited of
+        Just code | code /= ExitSuccess -> case either Left id result of
+          Left err -> do
+            hPutStrLn stderr ("iserv-proxy: interpreter exit status: " ++ show code)
+            pure (Left err)
+          Right () -> pure (Left (E.toException (interpreterExit code)))
+        _ -> pure (either Left id result)
+      case cleanupResult of
+        Left err -> case primary of
+          Left _ -> hPutStrLn stderr ("iserv-proxy: cleanup failed: " ++ E.displayException err)
+          Right () -> E.throwIO err
+        Right () -> pure ()
+      either E.throwIO pure primary
+    -- Route cancellation through the same result channel. An asynchronous
+    -- exception during cleanup could interrupt termination and leak the group.
+    withCancellationHandlers outcome action = do
+#if !defined(mingw32_HOST_OS)
+      let catchSignal sig err run = E.bracket
+            (installHandler sig (Catch (void $ tryPutMVar outcome (Left err))) Nothing)
+            (\previous -> void $ installHandler sig previous Nothing)
+            (const run)
+      catchSignal sigTERM (E.toException (ExitFailure 1)) $
+        catchSignal sigINT (E.toException E.UserInterrupt) $
+          catchSignal sigQUIT (E.toException E.UserInterrupt) action
+#else
+      action
+#endif
+    -- Polling also works when older aarch64 builds disable the threaded RTS;
+    -- a blocking waitpid would prevent the proxy and its timeout from running.
+    waitInterpreter ph = getProcessExitCode ph >>= maybe
+      (threadDelay 100000 >> waitInterpreter ph) pure
+    closePipe h = hClose h `E.catch` \(_ :: E.IOException) -> pure ()
+    interpreterExit code = userError ("iserv-proxy: interpreter terminated (" ++ show code ++ ")")

