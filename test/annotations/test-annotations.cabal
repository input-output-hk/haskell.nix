cabal-version: 1.24
name: test-annotations
version: 1
build-type: Simple
extra-source-files:
  reloc-fixture/reloc-fixture.cabal
  reloc-fixture/src/RelocProbe.hs
  reloc-fixture/cbits/rel10-a.c
  reloc-fixture/cbits/rel10-b.c

library
  exposed-modules: Lib
  hs-source-dirs: .
  build-depends: base
  default-language: Haskell2010
  if flag(i386-elf-got-relocations) && os(linux) && arch(i386)
    build-depends: template-haskell, reloc-fixture
    cpp-options: -DTEST_I386_ELF_GOT_RELOCS

flag i386-elf-got-relocations
  description: Exercise i386 ELF GOT relocations in the compile-time interpreter.
  default: False
  manual: True
